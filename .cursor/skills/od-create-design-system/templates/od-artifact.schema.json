{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-artifact.schema.json",
  "title": "OpenDesign Artifact",
  "type": "object",
  "required": ["name", "source", "htmlPath"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "source": { "const": "opendesign-export" },
    "htmlPath": { "type": "string", "minLength": 1 },
    "previewUrl": { "type": ["string", "null"] },
    "assetsDir": { "type": ["string", "null"] },
    "manifestPath": { "type": ["string", "null"] }
  }
}
