{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-component-catalog.schema.json",
  "title": "OpenDesign Component Catalog",
  "type": "object",
  "required": ["generatedAt", "projectRoot", "componentDirs", "components"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string" },
    "projectRoot": { "type": "string" },
    "componentDirs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "matches", "props"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "matches": {
            "type": "array",
            "items": { "type": "string" }
          },
          "props": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
