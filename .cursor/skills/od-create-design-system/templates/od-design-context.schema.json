{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-design-context.schema.json",
  "title": "OpenDesign Design Context",
  "type": "object",
  "required": ["generatedAt", "artifact", "architecture", "tokens", "serialized", "componentCatalogPath"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string" },
    "artifact": { "$ref": "od-artifact.schema.json" },
    "architecture": { "type": "object" },
    "tokens": { "type": "object" },
    "serialized": { "type": "object" },
    "componentCatalogPath": { "type": "string" },
    "rules": {
      "type": "object",
      "required": ["base", "page"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string" },
        "page": { "type": "string" }
      }
    }
  }
}
