{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rosey-design-context.schema.json",
  "title": "Rosey Design Context",
  "type": "object",
  "required": [
    "generatedAt",
    "artifact",
    "architecture",
    "tokens",
    "serialized",
    "componentCatalogPath",
    "pageSlug",
    "htmlChecksum",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string" },
    "htmlChecksum": { "type": "string" },
    "pageSlug": { "type": "string" },
    "artifact": { "$ref": "rosey-artifact.schema.json" },
    "architecture": { "type": "object" },
    "tokens": { "type": "object" },
    "designSystemResolved": { "type": ["object", "null"] },
    "resolvedTokens": { "type": ["object", "null"] },
    "failedTokens": {
      "type": "array",
      "items": { "type": "string" }
    },
    "serialized": { "type": "object" },
    "componentCatalogPath": { "type": "string" },
    "designSystem": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "checksum": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "content": { "type": "array", "items": { "type": "string" } },
              "listItems": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["title", "content", "listItems"]
          }
        },
        "tokens": {
          "type": "object",
          "properties": {
            "colors": { "type": "object", "additionalProperties": { "type": "string" } },
            "typography": { "type": "object", "additionalProperties": { "type": "string" } },
            "spacing": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "required": ["colors", "typography", "spacing"]
        }
      },
      "required": ["title", "category", "description", "sections", "tokens", "path", "checksum"]
    },
    "rules": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string" }
      }
    }
  }
}
