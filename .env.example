# Local environment for this checkout. Copy to .env (gitignored) and fill in.
#
# install.sh reads this checkout's .env to seed ~/.hindsight/embed on a machine
# that has no Hindsight config yet. It never reads a target repository's .env and
# never overwrites an existing ~/.hindsight/embed. Never commit real values.
#
# GITHUB_TOKEN / GH_TOKEN, MASH_PROGRAMMING_SKILLS, and the MASH_* toggles are
# read from the shell environment, not from this file.

# --- Hindsight local memory ---
# An OpenAI-compatible gateway keeps HINDSIGHT_API_LLM_PROVIDER=openai and points
# HINDSIGHT_API_LLM_BASE_URL at the gateway root. Native providers (gemini,
# anthropic, groq, deepseek, ...) leave BASE_URL empty. `none`, `ollama`,
# `lmstudio`, `llamacpp`, and `vertexai` need no API key.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_BASE_URL=

# Daemon API port for the default profile. Leave empty for 8888.
HINDSIGHT_API_PORT=

# --- Obsidian MCP (reserved) ---
# install.sh substitutes this into the MCP catalog; the current catalog ships no
# Obsidian server, so setting it has no effect yet.
# OBSIDIAN_API_KEY=
