
# This repo is the Rosey SOURCE and tracks .cursor/ and .agents/ directly.
# Re-include them here, because the machine-global gitignore excludes them for
# downstream install targets.
!.cursor/
!.agents/

# Cursor beforeShellExecution hook (append-only debug log)
.cursor/hooks/beforeShellExecution.log

# Local Rosey stack (secrets and runtime logs)
/.env
.cursor/mcp.json

# Local skill dependencies
.cursor/skills/**/node_modules/
.cursor/skills/**/.venv/
.cursor/skills/**/.pytest_cache/
.cursor/skills/**/.env
.cursor/skills/**/__pycache__/
.cursor/skills/**/*.pyc

# Rosey Agentic Environment
rosey/brainstorms/
rosey/plans/
rosey/designs/
rosey/solutions/
rosey/insights/
rosey/design-system/
rosey/qa/
rosey/parallel/
rosey/deepening/
rosey/loops/
rosey/ideation/
rosey/agentic-env.json
AGENTS.md
DESIGN.md

# Rosey Maintainer Tools
rosey/maintainer-manifest.json

inspiration/